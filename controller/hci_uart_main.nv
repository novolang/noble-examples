// One status line: the counters the Controller keeps.
@no_alloc
fn status(var c: Controller) [hw]
    hal.uart.write("hci_nrf54 answered=")
    log_int(c.answered)
    hal.uart.write(" unknown=")
    log_int(c.unknown)
    hal.uart.write(" resets=")
    log_int(c.rx.commands)
    hal.uart.write(" lost=")
    log_int(c.rx.lost)
    hal.uart.write(" discarded=")
    log_int(c.rx.discarded)
    hal.uart.write("\n")

// One status line: the octets the Host's port took and the turns it held one (the Host's flow control stopped it).
@no_alloc
fn status_port(p: HostPort) [hw]
    hal.uart.write("hci host sent=")
    log_int(p.sent)
    hal.uart.write(" held=")
    log_int(p.held)
    hal.uart.write("\n")

// One status line: what the public key engine did, with the time of the last and of the
// longest operation in microseconds.
fn status_ecdh(var e: ecdh_nrf54.Nrf54Ecdh) [hw, mutate]
    hal.uart.write("ecdh keys=")
    log_int(e.keys)
    hal.uart.write(" key_us=")
    log_int(e.key_us)
    hal.uart.write(" key_us_max=")
    log_int(e.key_us_max)
    hal.uart.write(" dhkeys=")
    log_int(e.dhkeys)
    hal.uart.write(" dh_us=")
    log_int(e.dh_us)
    hal.uart.write(" dh_us_max=")
    log_int(e.dh_us_max)
    hal.uart.write(" retries=")
    log_int(ecdh_nrf54.retries())
    hal.uart.write(" faults=")
    log_int(e.faults)
    hal.uart.write("\n")

// The main loop with the cipher `cc`: the CCM00 and ECB00 peripherals of the chip, or
// the software cipher of `ll_ccm.nv` on a chip without them.
fn run<C: Cipher>(var cc: C) [hw, mutate]
    bsp.board.init()
    hal.uart.init(BAUD)
    var c = ctl_hci.controller_new(ctl_hci.CAP_ECB | ctl_hci.CAP_RNG | ctl_hci.CAP_LL | ctl_hci.CAP_ECDH)
    var rf = ll_air.rf_new()
    var air = radio_nrf54.air_new()
    var rx = ll_pdu.pdu_new()
    var policy = ll_policy.default_link_policy()
    var rnd: Vec[u8; 12] = Vec.new()
    for _ in 0..12
        let _z = rnd.push(0)
    var key_rnd: Vec[u8; 32] = Vec.new()
    for _ in 0..32
        let _k = key_rnd.push(0)
    var ecdh = ecdh_nrf54.nrf54_ecdh_new()
    var port = host_port_new()
    status_leds.init()
    load_address(var c)
    rng_nrf54.start()
    radio_nrf54.air_init(var air)
    ll_air.air_profile(var air, var c)
    ctl_hci.ctl_seed(var c, hw.mem_read32(FICR_DEVICEADDR) ^ air.now_us())
    hal.uart.write("hci_nrf54 up\n")
    var next_status = hal.timer.ticks_us() + STATUS_US
    var shown = 0
    while true
        ctl_hci.ctl_set_time(var c, air.now_us())
        ctl_hci.ctl_set_room(var c, ctl_hci.ctl_ll_room(var c, air.now_us()))
        let _ran = ctl_hci.ctl_step(var c)
        run_hardware(var c, var cc)
        run_secure(var c, var cc, var rnd)
        run_ecdh(var c, var ecdh, var key_rnd)
        run_privacy(var c, var cc, var rnd)
        run_big(var c, var rnd)
        move_octets(var c, var air, var port, ctl_hci.ctl_ll_room(var c, air.now_us()))
        ll_air.ll_poll(var air, var c, var rf, var rx, var policy, var cc)
        status_leds.update(var c, air.now_us())
        // A stream that ends before it came up: its line goes out when it does, the status line comes too late for it.
        for k in 0..ctl_limits.cis_slots()
            if c.cis[k].state == ll_iso.S_CLOSING and c.cis[k].status != 0
                if (shown & (1 << k)) == 0
                    shown = shown | (1 << k)
                    hal.uart.write("cis_fail k=")
                    log_int(k)
                    hal.uart.write(" status=0x")
                    log_hex(c.cis[k].status)
                    hal.uart.write(" good=")
                    log_int(c.cis[k].n_good)
                    hal.uart.write(" bad=")
                    log_int(c.cis[k].n_bad)
                    hal.uart.write(" nulltx=")
                    log_int(c.cis[k].n_null_tx)
                    hal.uart.write(" err_n=")
                    log_int(c.cis[k].err_n)
                    hal.uart.write(" err_first=")
                    log_signed(c.cis[k].err_first)
                    hal.uart.write(" err_max=")
                    log_signed(c.cis[k].err_max)
                    hal.uart.write(" acl_err_min=")
                    log_signed(rf.acl_err_min)
                    hal.uart.write(" acl_err_max=")
                    log_signed(rf.acl_err_max)
                    hal.uart.write(" acl_err_last=")
                    log_signed(rf.acl_err_last)
                    hal.uart.write(" ind_ev=")
                    log_int(c.cis[k].ind_ev)
                    hal.uart.write(" off=")
                    log_int(c.cis[k].cis_offset)
                    hal.uart.write("\n")
            else
                shown = shown & (0xFF ^ (1 << k))
        if hal.timer.ticks_us() >= next_status
            status(var c)
            status_port(port)
            status_ecdh(var ecdh)
            status_ll(var c, var rf, var air)
            ll_air.reset_window(var rf)
            next_status = hal.timer.ticks_us() + STATUS_US

fn main() [hw, mutate]
    var cc = ccm_nrf54.nrf54_cipher_new()
    run(var cc)
